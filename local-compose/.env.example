# Copy to .env before the first `docker compose up`:
#
#   cp .env.example .env
#
# .env is gitignored so local port changes stay local. Everything below except
# COMPOSE_PROFILES also has a built-in default in docker-compose.yaml --
# COMPOSE_PROFILES is read by the Compose CLI itself, so it has to live here or
# only the control plane comes up.

# Which parts of the stack come up. Comment this out (or trim it) to run only
# the control plane -- Postgres, Kafka, Valkey, Keycloak, the APIs and the
# console.
#   druid,flink (default):  ~6.7GB  -> the full create -> publish -> ingest
#                                      -> query path for event datasets
#   + masterdata:           ~7.9GB  -> adds cache-indexer, only needed for
#                                      master datasets / denormalization
#   control plane only:     ~2.2GB
COMPOSE_PROFILES=druid,flink

# Everything is reached through nginx on this port. Changing it also changes the
# Keycloak redirect URI and the console's own base URL, which is why it is one
# variable rather than three.
HTTP_PORT=8080

# Host-side ports, only for poking at things directly.
POSTGRES_PORT=5432
KAFKA_HOST_PORT=29092
VALKEY_DEDUP_PORT=6379
VALKEY_DENORM_PORT=6380
DRUID_ROUTER_PORT=8888
DRUID_COORDINATOR_PORT=8081
DATASET_API_PORT=3000
COMMAND_API_PORT=8000
UNIFIED_PIPELINE_UI_PORT=8181
CACHE_INDEXER_UI_PORT=8182
